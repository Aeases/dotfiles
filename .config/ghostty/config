
theme="Flexoki Dark"
window-theme = ghostty
gtk-custom-css = ~/.config/ghostty/tabs.css
font-size=17
background-opacity=1.0
cursor-color=#FFFFFF
cursor-opacity=1
cursor-text=#FF0000
cursor-style=bar
keybind = ctrl+backspace=text:\x17
keybind = ctrl+c=copy_to_clipboard:mixed
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=text:\x03

