[Unit]
Description=Wine server pre-warm for CSP
After=default.target

[Service]
Type=simple
Environment=WINEPREFIX=/home/zane/.wine-csp
Environment=WINESERVER=/home/zane/.local/share/cspenguin/wine-11.4/bin/wineserver
Environment=WINEDEBUG=-all
ExecStartPre=-/home/zane/.local/share/cspenguin/wine-11.4/bin/wineserver -k
ExecStart=/home/zane/.local/share/cspenguin/wine-11.4/bin/wineserver -f
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
