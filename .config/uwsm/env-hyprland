# Sourced (POSIX sh) by uwsm for Hyprland sessions only, after ./env. Moved here from the

# input method
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
export SDL_IM_MODULE=fcitx
export GLFW_IM_MODULE=ibus
export INPUT_METHOD=fcitx

# cursor
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24

# Qt: Wayland, and colours/style/fonts from kdeglobals through KDE's platform theme, same as
# under Plasma (theme generated by ~/.scripts/resolve-qt-theme)
export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=kde

# kept literal (unexpanded ~), as hyprland.lua passed it
export ILLOGICAL_IMPULSE_VIRTUAL_ENV='~/.local/state/quickshell/.venv'
