"claudeCode.preferredLocation": "panel",
"workbench.startupEditor": "none",
"workbench.secondarySideBar.defaultVisibility": "hidden",
"chat.disableAIFeatures": true,
"gitlens.graph.details.location": "auto",
// Spelling: personal words live in the Enchant dictionary (shared with GTK apps),
// kept in ~/dotfiles/.config/enchant and git-crypt encrypted there.
"cSpell.language": "en-AU",
"cSpell.customDictionaries": {
    "personal": {
        "name": "personal",
        "path": "~/.config/enchant/en_AU.dic",
        "addWords": true,
        "scope": "user"
    }
},
"cSpell.languageSettings": [
    {
        "languageId": "latex",
        "ignoreRegExpList": [
            // initial-letter acronyms: \textbf{D}ata, \cancel{l}anguage
            "/\\\\[a-zA-Z]+\\{[A-Za-z]\\}[A-Za-z]+/g",
            // option keys: labelformat=, breaklines=, ...
            "/\\b[a-z]+(?==)/g",
            // file paths: ~/.local/share/texmf/...
            "/~?(?:\\/[\\w.-]+){2,}\\/?/g"
        ]
    }
],
// LaTeX: latexmk picks up xelatex + shell-escape from ~/.config/latexmk/latexmkrc.
// -auxdir is repeated here because LaTeX Workshop only finds the log via tool args.
"latex-workshop.latex.recipes": [
    { "name": "latexmk (xelatex)", "tools": ["latexmk"] },
    { "name": "latexmk (force)", "tools": ["latexmk-force"] }
],
"latex-workshop.latex.tools": [
    {
        "name": "latexmk",
        "command": "latexmk",
        "args": ["-interaction=nonstopmode", "-synctex=1", "-auxdir=.build", "%DOC%"]
    },
    {
        "name": "latexmk-force",
        "command": "latexmk",
        "args": ["-g", "-interaction=nonstopmode", "-synctex=1", "-auxdir=.build", "%DOC%"]
    }
],
"terminal.integrated.enableImages": true
}