#!/usr/bin/env bash
# Select a screen region, OCR it, copy the text to the clipboard.
# RapidOCR from ~/.envs/ml, falling back to tesseract.
set -o pipefail

geom=$(slurp) || exit 0 # Escape/cancel: do nothing
img=$(mktemp --suffix=.png)
trap 'rm -f "$img"' EXIT
hyprctl eval 'screenshot_privacy_lift()' >/dev/null 2>&1
grim -g "$geom" "$img" # if this fails, both OCR engines fail on the empty file below

engine=RapidOCR
text=$(~/.envs/ml/bin/python -I ~/.scripts/lib/rapidocr_stdin.py <"$img" 2>/dev/null) ||
	{ engine=tesseract; text=$(tesseract "$img" stdout -l "${OCR_LANG:-eng}" 2>/dev/null | tr -d '\f'); } ||
	{ notify-send -a OCR "OCR failed"; exit 1; }

[[ -n "${text//[[:space:]]/}" ]] || { notify-send -a OCR OCR "No text found"; exit 1; }
printf '%s' "$text" | wl-copy
notify-send -a OCR "OCR'd Text" "${text:0:200}"
