#!/usr/bin/env bash

set -uo pipefail

WAYBAR_CSS="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/screenshare.css"

HIDE_RULE='window#waybar #network { font-size: 0; min-width: 0; padding: 0; margin: 0; border-width: 0; }'

notify_pause() {
	if command -v swaync-client >/dev/null 2>&1 && pgrep -x swaync >/dev/null 2>&1; then
		swaync-client --dnd-"$1" >/dev/null 2>&1
	elif command -v hokum >/dev/null 2>&1 && pgrep -x hokum >/dev/null 2>&1; then
		hokum dnd "$1" >/dev/null 2>&1 # still shows critical notis
	elif command -v dunstctl >/dev/null 2>&1 && pgrep -x dunst >/dev/null 2>&1; then
		[ "$1" = "on" ] && dunstctl set-paused true || dunstctl set-paused false
	fi
}

write_css() {
	printf '/* Toggled by ~/.scripts/screenshare-privacy. Empty = nothing hidden. */\n%s\n' "$1" >"$WAYBAR_CSS"
}

case "${1:-}" in
on)
	notify_pause on
	write_css "$HIDE_RULE"
	;;
off)
	notify_pause off
	write_css ""
	;;
*)
	echo "usage: ${0##*/} {on|off}" >&2
	exit 2
	;;
esac
