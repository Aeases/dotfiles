#!/usr/bin/env -S python3 -I
import datetime, html.parser, json, re, sys, urllib.parse, urllib.request

if not 2 <= len(sys.argv) <= 3 or not sys.argv[1]:
    sys.exit("usage: bibref <url> [key]")
url = sys.argv[1]
key = sys.argv[2] if len(sys.argv) > 2 else ""

req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) bibref"})
with urllib.request.urlopen(req, timeout=20) as r:
    page = r.read().decode(r.headers.get_content_charset() or "utf-8", "replace")

class Meta(html.parser.HTMLParser):
    def __init__(self):
        super().__init__()
        self.meta, self.title, self.ld, self._in = {}, "", [], None
    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == "meta":
            name = (a.get("name") or a.get("property") or "").lower()
            if name and a.get("content"):
                self.meta.setdefault(name, []).append(a["content"].strip())
        elif tag == "title" or (tag == "script" and a.get("type") == "application/ld+json"):
            self._in = tag
            if tag == "script": self.ld.append("")
    def handle_endtag(self, tag):
        if tag == self._in: self._in = None
    def handle_data(self, data):
        if self._in == "title": self.title += data
        elif self._in == "script": self.ld[-1] += data

p = Meta(); p.feed(page)
m = lambda *names: next((p.meta[n] for n in names if n in p.meta), [])

ld = {}
for blob in p.ld:
    try: data = json.loads(blob)
    except ValueError: continue
    for item in (data.get("@graph", [data]) if isinstance(data, dict) else data):
        if isinstance(item, dict) and ("headline" in item or "datePublished" in item):
            ld = item; break
    if ld: break

title = (m("citation_title", "dc.title", "og:title", "twitter:title") or [ld.get("headline", "")] or [""])[0] or p.title
title = " ".join(title.split())

authors = m("citation_author", "dc.creator", "author")
if not authors:
    a = ld.get("author")
    authors = [x.get("name", "") for x in (a if isinstance(a, list) else [a]) if isinstance(x, dict)]
authors = [a for a in authors if a and not a.startswith("http")]

site = (m("og:site_name", "citation_publisher", "dc.publisher") or [""])[0]
site = site or urllib.parse.urlparse(url).netloc.removeprefix("www.")

# drop a trailing " - Site" / " | Site" that just repeats the site name or domain
labels = {site.lower()} | set(urllib.parse.urlparse(url).netloc.lower().split("."))
parts = re.split(r"\s+[-|–—·]\s+", title)
if len(parts) > 1 and parts[-1].lower() in labels:
    title = title[: len(title) - len(parts[-1])].rstrip(" -|–—·")

date = (m("citation_publication_date", "citation_date", "article:published_time", "dc.date", "date")
        or [ld.get("datePublished", "")])[0]
ym = re.match(r"(\d{4})(?:[-/](\d{1,2}))?", date or "")

def esc(s): return re.sub(r"([&%#$_])", r"\\\1", s)

if not key:
    words = [w for w in re.findall(r"[a-z0-9]+", title.lower()) if w not in {"a", "an", "the", "of", "and", "in", "on", "for", "to"}]
    key = "-".join(words[:3]) or "ref"

fields = [("title", "{" + esc(title) + "}")]
if authors: fields.append(("author", "{" + esc(" and ".join(authors)) + "}"))
fields.append(("howpublished", "{" + esc(site) + "}"))
if ym:
    fields.append(("year", "{" + ym[1] + "}"))
    if ym[2]: fields.append(("month", "jan feb mar apr may jun jul aug sep oct nov dec".split()[int(ym[2]) - 1]))
fields.append(("url", "{" + url + "}"))
fields.append(("note", "{Visited on " + datetime.date.today().isoformat() + "}"))

print("\n@misc{" + key + ",\n" + "".join(f"  {k:<12} = {v},\n" for k, v in fields) + "}")
